# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage data. The .coverage database is a build artifact and it bakes in
# absolute source paths from whoever ran it, so it has no business in a repo.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging / build
build/
dist/
*.egg-info/
*.egg
# PyInstaller writes a .spec next to whatever you point it at, and those are
# throwaway. The one under packaging/ is authored and reviewed, so it is not.
*.spec
!packaging/*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# PingerPlot runtime output (never commit captured data).
# NOTE: .gitignore has no inline comments — a trailing "# ..." becomes part of
# the pattern and silently matches nothing. Keep each comment on its own line.
# probe logs and CSV exports
*.csv
# saved sessions
pingerplot_*.json
# scratch / smoke scripts (single leading underscore) - but NEVER package
# dunders like __init__.py / __main__.py, or the package silently breaks.
_*.py
!__*.py

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
